# Database configuration
# Replace with actual PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sabha_db

# JWT Security configuration
SECRET_KEY=sabha-secret-key-phase1-backend-dev-mode-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Storage configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=lectures

# Groq ASR configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
